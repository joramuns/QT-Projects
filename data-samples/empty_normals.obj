# Пример файла .obj для плоского квадрата с нормалями и текстурами

# Вершины
v -1.0 0.0 1.0   # Вершина 1
v  1.0 0.0 1.0   # Вершина 2
v  1.0 0.0 -1.0  # Вершина 3
v -1.0 0.0 -1.0  # Вершина 4

# Текстурные координаты
vt 0.0 0.0   # Левый верхний угол
vt 1.0 0.0   # Правый верхний угол
vt 1.0 1.0   # Правый нижний угол
vt 0.0 1.0   # Левый нижний угол

# Нормали
vn   # Верхняя нормаль

# Грани
f 1/1/1 2/2/1 3/3/1 4/4/1   # Грань, образующая квадрат