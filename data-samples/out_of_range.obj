# Пример файла .obj для плоского квадрата с нормалями и текстурами

# Вершины
v -1.0 2.0 3.0   # Вершина 
v  4.0 5.0 6.0   # Вершина 
v  7.0 8.0 -9.0  # Вершина 
v -10.0 11.0 -12.0  # Вершина 

# Текстурные координаты
vt 55.0 66.0   # Левый верхний угол
vt 77.0 88.0   # Правый верхний угол
vt 99.0 11.0   # Правый нижний угол
vt 22.0 33.0   # Левый нижний угол

# Нормали
vn 0.0 1.0 0.0   # Верхняя нормаль

# Грани
f 155 2 3 4  # Грань, образующая квадрат